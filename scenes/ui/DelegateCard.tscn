[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/DelegateCard.gd" id="0_card"]
[ext_resource type="PackedScene" path="res://scenes/ui/StatRow.tscn" id="1_row"]

[node name="DelegateCard" type="PanelContainer"]
theme_type_variation = &"PanelInset"
script = ExtResource("0_card")

[node name="Box" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Head" type="HBoxContainer" parent="Box"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Frame" type="PanelContainer" parent="Box/Head"]
custom_minimum_size = Vector2(64, 64)
layout_mode = 2
size_flags_vertical = 4
mouse_filter = 2
theme_type_variation = &"PanelPortrait"

[node name="Initial" type="Label" parent="Box/Head/Frame"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"TitleLabel"
theme_override_font_sizes/font_size = 30
horizontal_alignment = 1
vertical_alignment = 1

[node name="Portrait" type="TextureRect" parent="Box/Head/Frame"]
unique_name_in_owner = true
layout_mode = 2
mouse_filter = 2
expand_mode = 1
stretch_mode = 6

[node name="Titles" type="VBoxContainer" parent="Box/Head"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 4
theme_override_constants/separation = 0

[node name="Name" type="Label" parent="Box/Head/Titles"]
unique_name_in_owner = true
layout_mode = 2
mouse_filter = 1
theme_type_variation = &"HeaderLabel"
text_overrun_behavior = 3

[node name="Role" type="Label" parent="Box/Head/Titles"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"SmallLabel"
text_overrun_behavior = 3

[node name="Stats" type="GridContainer" parent="Box"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/h_separation = 16
theme_override_constants/v_separation = 0
columns = 1

[node name="R0" parent="Box/Stats" instance=ExtResource("1_row")]
layout_mode = 2

[node name="R1" parent="Box/Stats" instance=ExtResource("1_row")]
layout_mode = 2

[node name="R2" parent="Box/Stats" instance=ExtResource("1_row")]
layout_mode = 2

[node name="R3" parent="Box/Stats" instance=ExtResource("1_row")]
layout_mode = 2

[node name="R4" parent="Box/Stats" instance=ExtResource("1_row")]
layout_mode = 2

[node name="R5" parent="Box/Stats" instance=ExtResource("1_row")]
layout_mode = 2
