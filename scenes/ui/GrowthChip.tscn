[gd_scene format=3]

[node name="GrowthChip" type="PanelContainer"]
theme_type_variation = &"PanelInset"

[node name="Box" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Portrait" type="TextureRect" parent="Box"]
unique_name_in_owner = true
custom_minimum_size = Vector2(44, 44)
layout_mode = 2
size_flags_vertical = 4
expand_mode = 1
stretch_mode = 6

[node name="Info" type="VBoxContainer" parent="Box"]
layout_mode = 2
size_flags_vertical = 4
theme_override_constants/separation = 0

[node name="Name" type="Label" parent="Box/Info"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"HeaderLabel"
theme_override_font_sizes/font_size = 15

[node name="Level" type="Label" parent="Box/Info"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"GoodLabel"
theme_override_font_sizes/font_size = 13

[node name="Job" type="Label" parent="Box/Info"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"BlueLabel"
theme_override_font_sizes/font_size = 13
