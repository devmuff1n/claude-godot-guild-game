[gd_scene format=3]

[node name="StatTile" type="PanelContainer"]
size_flags_horizontal = 3
mouse_filter = 0
theme_type_variation = &"PanelInset"

[node name="Box" type="VBoxContainer" parent="."]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = -2

[node name="Name" type="Label" parent="Box"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"CaptionLabel"
text = "ОЗ"

[node name="Value" type="Label" parent="Box"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"BigValueLabel"
theme_override_font_sizes/font_size = 22
text = "0"
