[gd_scene format=3]

[node name="PresetButton" type="Button"]
custom_minimum_size = Vector2(0, 58)
focus_mode = 0
theme_type_variation = &"ButtonList"

[node name="Box" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 14.0
offset_right = -14.0
mouse_filter = 2
theme_override_constants/separation = 0
alignment = 1

[node name="Name" type="Label" parent="Box"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"HeaderLabel"
theme_override_font_sizes/font_size = 16

[node name="Sub" type="Label" parent="Box"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"TinyLabel"
text_overrun_behavior = 3
