[node name="Controls" type="Label" parent="Center/Panel/Box"]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "1–4 — команды героя (меню замедляет бой, выбор цели останавливает)
ЛКМ по врагу — общая цель · ПКМ/Esc — отмена без затрат
C — к цели · N — в строй · Пробел — пауза
Красная полоса над врагом — подготовка приёма: её можно прервать
Зелья тратят бутылку и 1 ATB, павших не поднимают"
mouse_filter = 1
theme_type_variation = &"MutedLabel"
text = "Управление ⓘ"
horizontal_alignment = 1
