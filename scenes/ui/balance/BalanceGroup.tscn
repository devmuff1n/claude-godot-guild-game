[gd_scene format=3]

[node name="BalanceGroup" type="PanelContainer"]
theme_type_variation = &"PanelSection"

[node name="Box" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 6

[node name="Head" type="HBoxContainer" parent="Box"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Title" type="Label" parent="Box/Head"]
unique_name_in_owner = true
custom_minimum_size = Vector2(150, 0)
layout_mode = 2
theme_type_variation = &"HeaderLabel"

[node name="Sum" type="Label" parent="Box/Head"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"MutedLabel"
clip_text = true

[node name="AddEnemy" type="Button" parent="Box/Head"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 28)
layout_mode = 2
focus_mode = 0
theme_type_variation = &"ButtonSmall"
text = "+ враг"

[node name="RemoveGroup" type="Button" parent="Box/Head"]
unique_name_in_owner = true
custom_minimum_size = Vector2(30, 28)
layout_mode = 2
focus_mode = 0
tooltip_text = "Убрать целиком"
theme_type_variation = &"ButtonSmall"
text = "✕"

[node name="Rows" type="VBoxContainer" parent="Box"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 4
