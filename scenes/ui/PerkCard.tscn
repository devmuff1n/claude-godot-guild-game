[gd_scene format=3]

[node name="PerkCard" type="PanelContainer"]
theme_type_variation = &"PanelInset"

[node name="Box" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 4

[node name="Head" type="HBoxContainer" parent="Box"]
layout_mode = 2

[node name="Name" type="Label" parent="Box/Head"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 4
theme_type_variation = &"HeaderLabel"
text = "Перк"

[node name="ChooseButton" type="Button" parent="Box/Head"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 4
focus_mode = 0
theme_type_variation = &"ButtonSmall"
text = "Выбрать"

[node name="Desc" type="Label" parent="Box"]
unique_name_in_owner = true
custom_minimum_size = Vector2(50, 0)
layout_mode = 2
theme_type_variation = &"SmallLabel"
autowrap_mode = 3
