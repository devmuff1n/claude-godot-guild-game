[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/village/VillageTopBar.gd" id="1_bar"]
[ext_resource type="PackedScene" path="res://scenes/ui/Icon.tscn" id="2_icon"]
[ext_resource type="PackedScene" path="res://scenes/ui/ResourcePill.tscn" id="3_pill"]

[sub_resource type="ButtonGroup" id="ButtonGroup_nav"]

[node name="VillageTopBar" type="PanelContainer"]
custom_minimum_size = Vector2(0, 64)
anchor_right = 1.0
offset_bottom = 64.0
theme_type_variation = &"PanelTop"
script = ExtResource("1_bar")

[node name="Box" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Crest" parent="Box" instance=ExtResource("2_icon")]
