[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/expedition/ObjectivePanel.gd" id="1_obj"]
[ext_resource type="Script" path="res://scripts/ui/Bar.gd" id="2_bar"]
[ext_resource type="PackedScene" path="res://scenes/ui/ResourcePill.tscn" id="3_pill"]
[ext_resource type="PackedScene" path="res://scenes/ui/Icon.tscn" id="4_icon"]

[node name="ObjectivePanel" type="PanelContainer"]
custom_minimum_size = Vector2(330, 0)
offset_right = 330.0
theme_type_variation = &"PanelHud"
script = ExtResource("1_obj")

[node name="Box" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Head" type="HBoxContainer" parent="Box"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="ObjName" type="Label" parent="Box/Head"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 4
theme_type_variation = &"HeaderLabel"

[node name="Fire" parent="Box/Head" instance=ExtResource("4_icon")]
unique_name_in_owner = true
visible = false
custom_minimum_size = Vector2(18, 18)
layout_mode = 2
size_flags_vertical = 4
tooltip_text = "Горит!"
kind = "burnout"

[node name="ObjPct" type="Label" parent="Box/Head"]
unique_name_in_owner = true
custom_minimum_size = Vector2(52, 0)
layout_mode = 2
size_flags_vertical = 4
theme_type_variation = &"ValueLabel"
