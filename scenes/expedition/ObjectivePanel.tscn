cons_id = "kit"
value_width = 14.0

[node name="ObjBar" type="Control" parent="Box"]
unique_name_in_owner = true
custom_minimum_size = Vector2(40, 12)
layout_mode = 2
mouse_filter = 2
script = ExtResource("2_bar")
color = Color(0.95, 0.7, 0.25, 1)

[node name="Actions" type="HBoxContainer" parent="Box"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="RepairHero" type="OptionButton" parent="Box/Actions"]
unique_name_in_owner = true
custom_minimum_size = Vector2(118, 0)
layout_mode = 2
tooltip_text = "Кого отправить. Пока герой чинит или тушит, он не сражается."
focus_mode = 0

[node name="RepButton" type="Button" parent="Box/Actions"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
focus_mode = 0
